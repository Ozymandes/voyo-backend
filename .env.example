# VOYO - Environment Configuration
# Copy this file to .env and fill in your actual credentials

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
DATABASE_URL=your_database_connection_string_here

# API Keys (for later phases)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
TRIPADVISOR_API_KEY=your_tripadvisor_api_key_here

# App Configuration
DEBUG=True
LOG_LEVEL=INFO
PYTHONPATH=.

# Region Configuration
REGIONS=Cairo,Giza,Alexandria,Luxor,Aswan,Hurghada,Marsa Alam,Sinai

# Target POIs per region
TARGET_POIS_PER_REGION=20

# Rate Limiting
REQUEST_DELAY=1
MAX_RETRIES=3

# Cache settings
CACHE_TTL=3600