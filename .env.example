# VOYO - Environment Configuration
# Copy this file to .env and fill in your actual credentials

# Supabase Configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
# API Keys (for later phases)
GOOGLE_PLACES_API_KEY=
TRIPADVISOR_API_KEY=your_tripadvisor_api_key_here

# App Configuration
DEBUG=True
LOG_LEVEL=INFO
PYTHONPATH=.

# Region Configuration
REGIONS=Cairo,Giza,Alexandria,Luxor,Aswan,Hurghada,Marsa Alam,Sinai

# Target POIs per region
TARGET_POIS_PER_REGION=20

# Rate Limiting
REQUEST_DELAY=1
MAX_RETRIES=3

# LLM (Groq)
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8000

# LLM backend selection. Default (unset / groq) uses Groq above (production/
# demo path). Set to `opto` to route CLEO + planner + judge through the OPTO
# gateway instead — a free local multi-model endpoint used for evaluation /
# load runs that would otherwise exhaust the Groq free-tier quota.
VOYO_LLM_BACKEND=groq

# OPTO gateway (only used when VOYO_LLM_BACKEND=opto). OpenAI-compatible.
# Default gpt-4o-mini: the ONLY gateway model that passes BOTH distinct LLM
# tasks the pipeline requires — (a) the planner's structured-JSON POI
# selection and (b) CLEO's OpenAI-style function/tool calling — in
# head-to-head probing. gemma4-26b / gemma4-31b return empty content on (a);
# llama-4-scout-17b produces malformed nested tool calls on (b). One model
# across ablation + planner benchmark + deep CLEO keeps §4 reproducible.
OPTO_LLM_API_KEY=
OPTO_LLM_BASE_URL=
OPTO_LLM_MODEL=

# Weather (OpenWeatherMap)
WEATHER_API_KEY=

# Web Search (Tavily)
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily

# Redis
REDIS_URL=

# Cache settings
CACHE_TTL=3600